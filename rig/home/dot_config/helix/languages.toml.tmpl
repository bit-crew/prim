[language-server.basedpyright]
command = "basedpyright-langserver"
args = ["--stdio"]

[language-server.ruff]
command = "ruff"
args = ["server"]

[[language]]
name = "python"
scope = "source.python"
injection-regex = "python"
file-types = ["py"]
language-servers = ["basedpyright", "ruff"]
formatter = { command = "ruff", args = ["format", "-"] }
auto-format = true

# Debug de Python con debugpy. NO se instala global: cuando un proyecto lo
# necesite (debug remoto, etc.) -> `uv add --dev debugpy` y Helix lo usara via
# `python -m debugpy.adapter` del .venv del proyecto. Debug local del dia a dia
# se hace con pudb (global): pon `breakpoint()` y ejecuta el script.
[language.debugger]
name = "debugpy"
transport = "stdio"
command = "python"
args = ["-m", "debugpy.adapter"]

[[language.debugger.templates]]
name = "launch"
request = "launch"
completion = [{ name = "entrypoint", completion = "filename" }]
args = { mode = "launch", program = "{0}", console = "integratedTerminal" }

[[language]]
name = "toml"
language-servers = ["taplo"]

[[language]]
name = "yaml"
language-servers = ["yaml-language-server"]

[[language]]
name = "markdown"
language-servers = ["marksman"]

[language-server.rust-analyzer]
command = "rust-analyzer"

[[language]]
name = "rust"
language-servers = ["rust-analyzer"]
auto-format = true

# Debug de Rust con codelldb (adaptador DAP). Pon breakpoints en Helix y lanza
# con el comando :debug-start. codelldb debe estar en PATH (lo instala el
# run_once en ~/.local/bin/codelldb).
[language.debugger]
name = "codelldb"
transport = "stdio"
command = "codelldb"
args = ["--port", "{}"]
port-arg = "--port {}"

[[language.debugger.templates]]
name = "binary"
request = "launch"
completion = [{ name = "binary", completion = "filename" }]
args = { program = "{0}" }
{{- if eq .profile "vps" }}

# --- C/C++ (solo VPS) ---
[language-server.clangd]
command = "clangd"

[[language]]
name = "c"
language-servers = ["clangd"]
auto-format = true

[[language]]
name = "cpp"
language-servers = ["clangd"]
auto-format = true
{{- end }}

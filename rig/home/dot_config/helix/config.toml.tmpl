{{ if eq .profile "vps" -}}
theme = "zenbones_warm"
{{- else -}}
theme = "catppuccin_mocha"
{{- end }}

[editor]
# y/p/R usan el registro del portapapeles; el proveedor OSC 52 llega con helix 25.07
default-yank-register = "+"
line-number = "relative"
mouse = true
bufferline = "multiple"
color-modes = true
auto-save = true
# Lineas muy largas: se parten al ancho de la ventana (flexible, como en
# Windows): si agrandas o achicas la terminal, el corte se mueve solo.
# En helix 25.01+ soft-wrap es una TABLA, no un booleano: poner
# "soft-wrap = true" hace que helix RECHACE la config entera.
[editor.soft-wrap]
enable = true
max-wrap = 10              # columnas minimas antes del borde derecho
max-indent-retain = 40     # cuanta indentacion preservar al envolver
wrap-indicator = "\u21ba " # simbolo al inicio de la linea envuelta (deja "" para nada)

[editor.cursor-shape]
insert = "bar"
normal = "block"
select = "underline"

[editor.indent-guides]
render = true
character = "▏"
skip-levels = 1

[editor.lsp]
display-messages = true
display-inlay-hints = true
auto-signature-help = true

[editor.statusline]
left = ["mode", "spinner", "file-name", "file-modification-indicator"]
center = []
right = ["diagnostics", "selections", "position", "file-encoding", "file-line-ending", "file-type"]
mode.normal = "NORMAL"
mode.insert = "INSERT"
mode.select = "SELECT"

# Recargar buffers desde disco (util cuando otro proceso modifica archivos
# abiertos). Ctrl-r en normal mode recarga todos los buffers.
[keys.normal]
C-r = ":reload-all"

# lazygit integrado (como el plugin de Vim, pero sin plugins: Helix no los tiene
# aun). Alt-g suspende Helix, abre lazygit a pantalla completa y al salir vuelve
# recargando los archivos (por si lazygit hizo checkout/stash/etc.). Se usa A-g
# en vez de C-g para no chocar con atajos del multiplexer (Herdr).
A-g = [
  ":write-all",
  ":new",
  ":insert-output lazygit",
  ":buffer-close!",
  ":redraw",
  ":reload-all",
]

# Archivos ocultos visibles en el picker (space+f) y el explorador (space+e;
# la opcion del explorador existe desde helix 25.07 — inerte en versiones viejas).
[editor.file-picker]
hidden = false

# El explorador (space+e) pide helix >= 25.07. El rig instala siempre la
# version mas reciente (nixos-unstable), asi que esto esta disponible; en una
# helix vieja esta opcion hace que la config ENTERA no cargue.
[editor.file-explorer]
hidden = false
